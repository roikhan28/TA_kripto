# =============================================================================
# GYMVAULT V2.0 - ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================

NODE_ENV=development
APP_PORT=5173

# Database Connection (MySQL / XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gymvault
DB_CONNECTION_LIMIT=10

# Cryptographic Master Storage
CRYPTO_MASTER_SALT=change_this_to_32_hex_chars_in_production
CRYPTO_KEY_VERSION=1

# Storage Paths
STORAGE_ENCRYPTED_FILES=./storage/encrypted_files
STORAGE_STEGO_IMAGES=./storage/stego_images
CHECKPOINT_FILE_PATH=./storage/.gymvault_checkpoint

# Biometric Configuration
FACE_CONFIDENCE_THRESHOLD=0.650
FACE_MODEL_PATH=./assets/models/mobilefacenet.onnx

# USB Dongle Challenge Configuration
DONGLE_TIMEOUT_MS=5000
