{
  "name": "gymvault",
  "version": "2.0.0",
  "description": "GYMVAULT V2.0 - Smart Gym Management & Security System",
  "main": "electron/main.js",
  "homepage": "./",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 -t 30000 -- electron .",
    "build": "vite build && electron-builder",
    "build:vite": "vite build",
    "preview": "vite preview",
    "test": "node tests/run-tests.js"
  },
  "dependencies": {
    "argon2": "^0.31.2",
    "dotenv": "^16.4.5",
    "electron-store": "^8.1.0",
    "lucide-react": "^0.344.0",
    "mysql2": "^3.6.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "recharts": "^2.12.0",
    "sharp": "^0.33.2",
    "usb": "^2.11.0",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^8.2.2",
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.4",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.gymvault.app",
    "productName": "GYMVAULT",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "backend/**/*",
      "crypto/**/*",
      "security/**/*",
      "modules/**/*",
      "storage/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "keywords": [
    "gym-management",
    "cryptography",
    "argon2id",
    "vigenere",
    "aes-256-gcm",
    "chacha20-poly1305",
    "steganography-lsb",
    "blockchain-sha256",
    "electron"
  ],
  "author": "GYMVAULT Engineering Team",
  "license": "ISC"
}
